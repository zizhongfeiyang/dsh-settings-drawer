{
  "name": "dsh-settings-drawer",
  "version": "1.3.0",
  "description": "Settings drawer for DSH: customize settings sections, plugin tabs, and configuration entries.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zizhongfeiyang/dsh-settings-drawer.git"
  },
  "homepage": "https://github.com/zizhongfeiyang/dsh-settings-drawer",
  "bugs": {
    "url": "https://github.com/zizhongfeiyang/dsh-settings-drawer/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "settings",
    "web-ui"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/client.js && node --check lib/index.js"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "dsh-renderer-current": "npm:@deepseek-ai/dsh-client-ui-renderer@0.2.0-rc.2",
    "dsh-slots-current": "npm:@deepseek-ai/dsh-client-ui-slots@0.2.0-rc.2",
    "dsh-slots-legacy": "npm:@deepseek-ai/dsh-client-ui-slots@0.1.0-rc.7",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
