{
  "name": "dsh-settings-cleaner",
  "version": "1.1.0",
  "description": "Settings drawer for DSH: choose which settings nav items stay visible.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "settings",
    "web-ui"
  ],
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
