{
  "name": "dsh-settings-drawer",
  "version": "1.1.1",
  "description": "Settings drawer for DSH: choose which settings nav items stay visible.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zizhongfeiyang/dsh-settings-drawer.git"
  },
  "homepage": "https://github.com/zizhongfeiyang/dsh-settings-drawer",
  "bugs": {
    "url": "https://github.com/zizhongfeiyang/dsh-settings-drawer/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "settings",
    "web-ui"
  ],
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
